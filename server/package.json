{
  "name": "flashback-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "catalog:build": "tsx src/scripts/build-catalog.ts",
    "catalog:download": "tsx src/scripts/download-media.ts",
    "catalog:verify": "tsx src/scripts/verify-years.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "ws": "^8.22.0"
  }
}
